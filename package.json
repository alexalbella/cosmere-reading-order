{
  "name": "cosmere-reading-order",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cosmere reading order with per-book spoiler gating. Vue 3 rewrite of 17thshard/reading-order.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/build-data.ts && vite",
    "build": "tsx scripts/build-data.ts && vue-tsc --noEmit && vue-tsc --noEmit -p worker && vite build && tsx scripts/check-budget.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jose": "^6.2.15",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.157.0"
  }
}
